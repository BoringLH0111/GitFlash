<Window x:Class="GitFlash.NewBranchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建分支" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <StackPanel Margin="16">
        <TextBlock Text="分支名称" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtBranch" Height="28" Padding="4" VerticalContentAlignment="Center"
                 KeyDown="TxtBranch_KeyDown"/>

        <TextBlock Text="提示：新分支会从当前分支的最新提交创建，创建后自动切换过去。" 
                   Foreground="#888" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" Width="80" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="创建" Width="80" Background="#4B3FE3" Foreground="White"
                    BorderThickness="0" Cursor="Hand" Click="BtnOk_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
