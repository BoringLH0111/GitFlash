<Window x:Class="GitFlash.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="GitFlash" Height="640" Width="1100"
        MinWidth="900" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Icon="/app.ico"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <Window.Resources>
        <!-- ===== 配色体系 ===== -->
        <SolidColorBrush x:Key="BrushPrimary" Color="#4B3FE3"/>
        <SolidColorBrush x:Key="BrushPrimaryHover" Color="#3D31C9"/>
        <SolidColorBrush x:Key="BrushPrimarySoft" Color="#EFEDFD"/>
        <SolidColorBrush x:Key="BrushBg" Color="#F2F4F8"/>
        <SolidColorBrush x:Key="BrushPanel" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushBorder" Color="#E4E7EC"/>
        <SolidColorBrush x:Key="BrushText" Color="#1F2430"/>
        <SolidColorBrush x:Key="BrushText2" Color="#6B7280"/>
        <SolidColorBrush x:Key="BrushText3" Color="#9CA3AF"/>

        <!-- 图标（Segoe MDL2 Assets，Windows 自带字体） -->
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 通用按钮：圆角 + 悬停/按下反馈 -->
        <Style x:Key="ToolBarButton" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushPrimarySoft}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#C9C3F5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DFDBF8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮（提交等关键操作）：紫色实底 -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrushPrimary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderThickness="0" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushPrimaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3529B0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#A5A0E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 面板标题 -->
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        </Style>

        <!-- 列表项：圆角 + 悬停/选中高亮 -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="5"
                                Padding="{TemplateBinding Padding}" Margin="1,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushPrimarySoft}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 列表容器：圆角卡片 -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="3">
                            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 输入框：圆角 + 聚焦高亮 -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          Focusable="False"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#F2F3F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 工具栏 -->
            <RowDefinition Height="*"/>      <!-- 主体三栏 -->
        </Grid.RowDefinitions>

        <!-- ========== 工具栏 ========== -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="0,0,0,1" Padding="10,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" x:Name="CurrentRepoText" Text="未打开仓库"
                           Foreground="#6B7280" VerticalAlignment="Center" Margin="4,0,8,0"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="GitFlash" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{StaticResource BrushPrimary}" Margin="4,0,20,0"/>
                    <Button Style="{StaticResource ToolBarButton}" Click="BtnOpenRepo_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource IconText}"/>
                            <TextBlock Text=" 打开仓库" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolBarButton}" Click="BtnCloneRepo_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource IconText}"/>
                            <TextBlock Text=" 克隆仓库" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Separator Width="1" Height="20" Background="#E4E7EC" Margin="0,0,10,0"/>
                    <Button x:Name="BtnToggleRepo" Content="◂ 收起仓库栏" Style="{StaticResource ToolBarButton}" Click="BtnToggleRepo_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ========== 主体三栏 ========== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColRepo" Width="240" MinWidth="0"/>
                <ColumnDefinition Width="Auto"/>                       <!-- 分隔条 1 -->
                <ColumnDefinition Width="1*" MinWidth="220"/>           <!-- 中栏 -->
                <ColumnDefinition Width="Auto"/>                       <!-- 分隔条 2 -->
                <ColumnDefinition Width="1*" MinWidth="240"/>           <!-- 右栏 -->
            </Grid.ColumnDefinitions>

            <!-- ===== 左栏：仓库列表 + 仓库文件浏览 ===== -->
            <Border Grid.Column="0" x:Name="RepoPanel" Background="#FAFBFC" BorderBrush="#E4E7EC" BorderThickness="0,0,1,0" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- 总标题 -->
                        <RowDefinition Height="Auto"/>   <!-- 仓库列表标题 -->
                        <RowDefinition Height="1.2*"/>   <!-- 仓库列表 -->
                        <RowDefinition Height="Auto"/>   <!-- 文件树标题 -->
                        <RowDefinition Height="*"/>      <!-- 文件树 -->
                        <RowDefinition Height="Auto"/>   <!-- 状态 -->
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="文件浏览器" Style="{StaticResource PanelTitle}"/>

                    <TextBlock Grid.Row="1" Text="我的仓库" FontSize="12" FontWeight="SemiBold" Foreground="#888" Margin="0,0,0,2"/>
                    <ListBox x:Name="RepoListBox" Grid.Row="2" BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="RepoListBox_SelectionChanged">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="从列表中移除" Click="RemoveRepo_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>

                    <TextBlock Grid.Row="3" Text="仓库文件" FontSize="12" FontWeight="SemiBold" Foreground="#888" Margin="0,10,0,2"/>
                    <TreeView x:Name="FileTreeView" Grid.Row="4" BorderThickness="1" BorderBrush="#E8E9EC"
                              Background="#FBFBFB"
                              TreeViewItem.Expanded="FileTreeView_Expanded"
                              SelectedItemChanged="FileTreeView_SelectedItemChanged">
                    </TreeView>

                    <TextBlock Grid.Row="5" x:Name="RepoStatusText" Text="" Foreground="#888" FontSize="11" Margin="0,4,0,0"/>
                </Grid>
            </Border>
            <GridSplitter x:Name="Splitter1" Grid.Column="1" Width="5" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="#E4E7EC" ResizeBehavior="PreviousAndNext"
                          ShowsPreview="False"/>

            <!-- ===== 中栏：变更区 ===== -->
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="0,0,1,0" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- 标题 -->
                        <RowDefinition Height="Auto"/>   <!-- 操作按钮 -->
                        <RowDefinition Height="*"/>      <!-- 文件列表 -->
                        <RowDefinition Height="Auto"/>   <!-- 提交区 -->
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="变更" Style="{StaticResource PanelTitle}"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Style="{StaticResource ToolBarButton}" Padding="8,3" Click="StageAll_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="11"/>
                                <TextBlock Text=" 暂存全部" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolBarButton}" Padding="8,3" Click="RevertAll_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" FontSize="11"/>
                                <TextBlock Text=" 撤回修改" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolBarButton}" Padding="8,3" Click="RefreshChanges_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="11"/>
                                <TextBlock Text=" 刷新" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ListBox x:Name="ChangesListBox" Grid.Row="2" BorderThickness="1" BorderBrush="#E8E9EC"
                             HorizontalContentAlignment="Stretch"
                             SelectionChanged="ChangesListBox_SelectionChanged"
                             PreviewMouseRightButtonDown="ChangesListBox_PreviewMouseRightButtonDown">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="暂存" Click="StageFile_Click"/>
                                <MenuItem Header="取消暂存" Click="UnstageFile_Click"/>
                                <Separator/>
                                <MenuItem Header="撤回修改" Click="RevertFile_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>

                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                        <TextBox x:Name="CommitMessageBox" Height="60" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Padding="6"
                                 Text="提交说明…"/>
                        <Button x:Name="CommitButton" Content="提交暂存" Height="30" Margin="0,8,0,0"
                                Style="{StaticResource PrimaryButton}"
                                Click="CommitButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <GridSplitter x:Name="Splitter2" Grid.Column="3" Width="5" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="#E4E7EC" ResizeBehavior="PreviousAndNext"
                          ShowsPreview="False"/>

            <!-- ===== 右栏：历史视图 / 对比视图（双模式） ===== -->
            <Border Grid.Column="4" Background="#FFFFFF" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- 标题 + 模式切换 -->
                        <RowDefinition Height="Auto"/>   <!-- 拉取 / 推送 -->
                        <RowDefinition Height="*"/>      <!-- 内容区 -->
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <TextBlock Text="历史 / 对比" Style="{StaticResource PanelTitle}"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="BtnToHistory" Style="{StaticResource ToolBarButton}" Padding="8,2" Click="BtnToHistory_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE81C;" Style="{StaticResource IconText}" FontSize="11"/>
                                    <TextBlock Text=" 历史" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnToDiff" Content="对比" Style="{StaticResource ToolBarButton}" Padding="8,2" Click="BtnToDiff_Click"/>
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Style="{StaticResource ToolBarButton}" Padding="8,3" Click="Pull_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource IconText}" FontSize="11"/>
                                <TextBlock Text=" 拉取" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolBarButton}" Padding="8,3" Click="Push_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE898;" Style="{StaticResource IconText}" FontSize="11"/>
                                <TextBlock Text=" 推送" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- ===== 历史视图：分支 + 提交历史 ===== -->
                    <Grid x:Name="HistoryPanel" Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- 分支标题 -->
                            <RowDefinition Height="Auto"/>   <!-- 分支列表 -->
                            <RowDefinition Height="Auto"/>   <!-- 历史标题 -->
                            <RowDefinition Height="*"/>      <!-- 提交历史 -->
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <TextBlock Text="分支" Style="{StaticResource PanelTitle}" FontSize="13"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolBarButton}" Padding="8,2" Click="NewBranch_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource IconText}" FontSize="11"/>
                                    <TextBlock Text=" 新建分支" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>

                        <ListBox x:Name="BranchListBox" Grid.Row="1" Height="104" Margin="0,0,0,4"
                                 BorderThickness="1" BorderBrush="#E8E9EC"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="BranchListBox_SelectionChanged">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="切换到选中分支" Click="SwitchBranch_Click"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>

                        <TextBlock Grid.Row="2" Text="提交历史" Style="{StaticResource PanelTitle}" FontSize="13" Margin="0,10,0,4"/>

                        <ListBox x:Name="CommitListBox" Grid.Row="3" BorderThickness="1" BorderBrush="#E8E9EC"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="CommitListBox_SelectionChanged">
                        </ListBox>
                    </Grid>

                    <!-- ===== 对比视图：文件名 + 两列对比（左：修改前 / 右：修改后） ===== -->
                    <Grid x:Name="DiffPanel" Grid.Row="2" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- 文件名 + 返回 -->
                            <RowDefinition Height="*"/>      <!-- 两列对比 -->
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="返回历史" Style="{StaticResource ToolBarButton}" Padding="8,2" Click="BtnToHistory_Click"/>
                            <TextBlock x:Name="DiffFileText" Text="" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </DockPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左列：修改前（删除行为红色） -->
                            <Border Grid.Column="0" Background="#FDF7F7" BorderBrush="#E8E9EC" BorderThickness="1,1,0,1">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="修改前" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#C62828" Padding="6,4" Background="#F7EBEB"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="DiffBeforeText" FontFamily="Consolas" FontSize="12"
                                                   TextWrapping="NoWrap" Padding="8" Text="（点击中间的文件查看代码对比）"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <!-- 右列：修改后（新增行为绿色） -->
                            <Border Grid.Column="1" Background="#F6FBF7" BorderBrush="#E8E9EC" BorderThickness="0,1,1,1">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="修改后" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#1E7D32" Padding="6,4" Background="#E8F5EA"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="DiffAfterText" FontFamily="Consolas" FontSize="12"
                                                   TextWrapping="NoWrap" Padding="8"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ===== 文件内容视图：点击左栏文件时显示，支持编辑与保存 ===== -->
                    <Grid x:Name="FilePanel" Grid.Row="2" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- 文件名 + 操作按钮 -->
                            <RowDefinition Height="*"/>      <!-- 文件内容 -->
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" x:Name="SaveFileButton"
                                    Style="{StaticResource ToolBarButton}" Padding="8,2" Click="SaveFile_Click" IsEnabled="False">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" Style="{StaticResource IconText}" FontSize="11"/>
                                    <TextBlock Text=" 保存" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button DockPanel.Dock="Right" Content="返回历史" Style="{StaticResource ToolBarButton}" Padding="8,2" Click="BtnToHistory_Click"/>
                            <TextBlock x:Name="FileViewText" Text="" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </DockPanel>

                        <Border Grid.Row="1" Background="#FBFBFB" BorderBrush="#E8E9EC" BorderThickness="1">
                            <TextBox x:Name="FileContentBox" FontFamily="Consolas" FontSize="12"
                                     TextWrapping="NoWrap" Padding="8" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     BorderThickness="0" Background="Transparent" IsReadOnly="True"
                                     TextChanged="FileContentBox_TextChanged"/>
                        </Border>
                    </Grid>

                    <!-- ===== 提交详情视图：点击历史提交后显示 ===== -->
                    <Grid x:Name="CommitPanel" Grid.Row="2" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- 返回 + 提交说明 -->
                            <RowDefinition Height="Auto"/>   <!-- hash · 作者 · 时间 -->
                            <RowDefinition Height="Auto"/>   <!-- 修改的文件列表 -->
                            <RowDefinition Height="*"/>      <!-- 两列 diff -->
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="返回历史" Style="{StaticResource ToolBarButton}" Padding="8,2" Click="BtnToHistory_Click"/>
                            <TextBlock x:Name="CommitDetailTitle" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </DockPanel>

                        <TextBlock Grid.Row="1" x:Name="CommitDetailMeta" FontSize="11"
                                   Foreground="#999" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>

                        <DockPanel Grid.Row="2" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Top" Text="修改的文件" FontSize="12"
                                       FontWeight="SemiBold" Foreground="#888" Margin="0,0,0,2"/>
                            <ListBox x:Name="CommitFileListBox" BorderThickness="1" BorderBrush="#E8E9EC"
                                     MaxHeight="130"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="CommitFileListBox_SelectionChanged"/>
                        </DockPanel>

                        <!-- 两列 diff：左 修改前（红）/ 右 修改后（绿） -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#FDF7F7" BorderBrush="#E8E9EC" BorderThickness="1,1,0,1">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="修改前" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#C62828" Padding="6,4" Background="#F7EBEB"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="CommitDiffBeforeText" FontFamily="Consolas" FontSize="12"
                                                   TextWrapping="NoWrap" Padding="8"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#F6FBF7" BorderBrush="#E8E9EC" BorderThickness="0,1,1,1">
