<Window x:Class="GitFlash.CloneDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="克隆远程仓库" Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <StackPanel Margin="16">
        <TextBlock Text="远程地址" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtUrl" Height="28" Padding="4" VerticalContentAlignment="Center"
                 Text="https://github.com/用户名/仓库名.git"/>

        <TextBlock Text="保存到（克隆时会在该目录下自动创建仓库文件夹）" Margin="0,12,0,4"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtFolder" Height="28" Padding="4" VerticalContentAlignment="Center"/>
            <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Padding="12,2" Click="BtnBrowse_Click"/>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" Width="80" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="克隆" Width="80" Background="#4B3FE3" Foreground="White"
                    BorderThickness="0" Cursor="Hand" Click="BtnOk_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
